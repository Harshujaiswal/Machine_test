SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INVITE_TOKEN_EXPIRE_HOURS=6

# Local development fallback:
# DATABASE_URL=sqlite:///./machine_test.db
# Vercel/Supabase: use the Transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_USE_TLS=true

FRONTEND_BASE_URL=https://your-frontend-domain.example
DEFAULT_ADMINS=admin@example.com:replace-with-a-strong-password
DEFAULT_GEMINI_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
